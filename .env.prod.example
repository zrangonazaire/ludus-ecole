# Copy to .env.prod on the VPS only. Fill every empty value.
COMPOSE_PROJECT_NAME=eduops-prod
IMAGE_TAG=production
APP_BASE_URL=https://ecole.ton-domaine.com
POSTGRES_DB=eduops
POSTGRES_USER=eduops
# Generate each password separately: openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Generate JWT secret: openssl rand -hex 64
JWT_SECRET=
EDUOPS_ADMIN_EMAIL=
EDUOPS_ADMIN_PASSWORD=
# SMTP authenticated STARTTLS (usually port 587)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
SCHOOL_NAME=Mon Ecole
SCHOOL_CODE=ECOLE
SCHOOL_CURRENCY=XOF
SCHOOL_TIMEZONE=Africa/Abidjan
