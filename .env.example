# ============================================================
# EduOps - Environment configuration (example)
# Copy to .env and adapt. NEVER commit the real .env file.
# ============================================================

COMPOSE_PROJECT_NAME=eduops

# ---------- PostgreSQL ----------
POSTGRES_DB=eduops
POSTGRES_USER=eduops
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_EXPOSED_PORT=55432

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=change_me_redis
REDIS_EXPOSED_PORT=56379

# ---------- Mail (Mailpit in DEV) ----------
MAIL_HOST=localhost
MAIL_PORT=51025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@eduops.local
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025

# ---------- Security ----------
# Base64 or plain secret, minimum 64 characters for HS512
JWT_SECRET=change_me_this_must_be_a_very_long_random_secret_at_least_64_chars_long
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ---------- Application ----------
APP_BASE_URL=http://localhost:4200
API_BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=58080
FRONTEND_PORT=4200

# ---------- School identity ----------
SCHOOL_NAME=Groupe Scolaire Horizon
SCHOOL_CODE=GSH
SCHOOL_CURRENCY=XOF
SCHOOL_LOCALE=fr-CI
SCHOOL_TIMEZONE=Africa/Abidjan

# ---------- Numbering ----------
STUDENT_NUMBER_PATTERN=EDU-{year}-{seq:6}
RECEIPT_NUMBER_PATTERN=REC-{year}-{seq:8}
INVOICE_NUMBER_PATTERN=INV-{year}-{seq:8}

# ---------- Docker registry (configurable) ----------
DOCKER_REGISTRY=localhost:5000
REGISTRY_PORT=5000
IMAGE_TAG=latest

# ---------- Default bootstrap administrator ----------
EDUOPS_ADMIN_EMAIL=admin@eduops.local
EDUOPS_ADMIN_PASSWORD=ChangeMe!2026
