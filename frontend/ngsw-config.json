{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/*.(svg|png|jpg|webp|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "reference-data",
      "urls": ["/api/v1/classes**", "/api/v1/subjects**", "/api/v1/academic-years**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "3s"
      }
    },
    {
      "name": "teacher-offline",
      "urls": ["/api/v1/teacher/classes**", "/api/v1/teacher/timetable**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 60,
        "maxAge": "12h"
      }
    }
  ]
}
